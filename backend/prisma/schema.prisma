generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Candidate {
  id        String   @id @default(uuid())
  name      String
  phone     String
  position  String
  stage     String   @default("Applied")
  createdAt DateTime @default(now())
}